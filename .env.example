# Porta do Logger
PORT=10000

# Mongo
MONGODB_URI=mongodb+srv://login:123@cluster0.123123.mongodb.net/?appName=Cluster0
MONGO_DB=whatsapp
MONGO_COL=messages
MSG_TTL_DAYS=0

# WhatsApp Web JS
WWEBJS_CLIENT_ID=whatsapp-bot
WWEBJS_STORE=/app/data/wwebjs

# Mídia
MEDIA_DIR=/app/data/media

# OpenAI
OPENAI_API_KEY=sk-kv...
OPENAI_CHAT_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1

# IA SDR
BOT_NAME=AitoSoftwares

# Painel
DASH_TOKEN=

# Cooldown humano (ms)
HUMAN_HOLD_MS=300000

IA_CONTEXT_MAX_MINUTES=5

# Puppeteer/Chromium (para Docker)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true
